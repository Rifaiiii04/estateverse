# EstateVerse Backend Configuration Example
PORT=8085
APP_ENV=development

# MySQL connection string (Laragon default: user root without password)
DB_DSN="root:@tcp(127.0.0.1:3306)/estateverse_mvp?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci&loc=UTC"

# Frontend origin for CORS and CSRF validation
FRONTEND_ORIGIN="http://localhost:3000"

# Session duration in hours
SESSION_TTL_HOURS=72

# Storage directory for uploaded media (photos, 3D models, 360° panoramas)
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_MB=50

# Set to true only when running behind a reverse proxy (Caddy/Nginx) that sets X-Forwarded-For
TRUST_PROXY=false

# Smart Assistant via OpenRouter (leave empty to use the offline answers)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Seeder (go run ./cmd/seed): password for demo seller accounts and optional demo WhatsApp number
SEED_PASSWORD=
SEED_WHATSAPP=
