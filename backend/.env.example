# EstateVerse Backend Configuration Example
PORT=8085
APP_ENV=development

# MySQL Database Connection String (Laragon standard default: user root with empty password)
DB_DSN="root:@tcp(127.0.0.1:3306)/estateverse_mvp?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci&loc=Local"

# Frontend Origin for CORS and CSRF validation
FRONTEND_ORIGIN="http://localhost:3000"

# Session Duration in Hours
SESSION_TTL_HOURS=72

# Storage Directory for uploaded media
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_MB=50
