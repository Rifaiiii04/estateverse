# Salin menjadi deploy/.env lalu isi nilainya. JANGAN commit file .env.

# Domain yang mengarah ke IP VPS (A record). Belum punya domain? Pakai sslip.io,
# contoh untuk IP 203.0.113.10: DOMAIN=203-0-113-10.sslip.io
DOMAIN=

# Password database (buat acak dan panjang).
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Asisten Pintar via OpenRouter (https://openrouter.ai). Kosongkan untuk memakai jawaban offline.
# Pilih model gratis yang berakhiran ":free" dari daftar model OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Password akun penjual contoh yang dibuat oleh seeder (minimal 8 karakter).
SEED_PASSWORD=

# Nomor WhatsApp tim untuk listing demo (opsional). Kosongkan agar tombol WA demo tidak menghubungi siapa pun.
SEED_WHATSAPP=

# Email untuk tautan "Lupa password" (wajib TLS: port 587 STARTTLS atau 465). Kosongkan SMTP_HOST bila belum ada;
# fitur lupa password tidak bisa mengirim email sampai diisi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
